// niri 配置（M2 最小 substrate；docs/architecture/graphics.md）。
// GPU-neutral：不写 DRM 节点、不写死 output 名（niri 自动探测；
// host-specific 显示设置未来通过 host-specific Home overlay 表达）。
// 会话内长期进程的单一 owner 是 niri session（spawn-at-startup）——
// 不在 Home Shepherd / 系统 shepherd / wrapper 重复启动。

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
}

// 会话服务（graphical owner = niri session）：mako/lxpolkit 是
// 纯图形会话组件；PipeWire/WirePlumber 由官方 Home service 接管
// （home-pipewire-service-type，Home Shepherd owner——
// docs/architecture/upstream-boundaries.md）。
spawn-at-startup "mako"                 // notification daemon
spawn-at-startup "lxpolkit"             // graphical polkit agent (lxsession)

binds {
    Mod+Return { spawn "foot"; }        // terminal
    Mod+D { spawn "fuzzel"; }           // launcher
    Mod+Shift+E { quit; }               // logout -> greetd
}
