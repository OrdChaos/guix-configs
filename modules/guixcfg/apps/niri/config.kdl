// niri 配置入口（application-owned，host-agnostic，薄 assembly）。
//
// include 语义（pinned niri 26.04，niri-config/src/lib.rs 核实）：
//   - 相对路径以【包含该 include 的文件所在目录】为基准（顶层
//     BasePath = config.kdl 所在目录 = ~/.config/niri/）；
//   - 允许多个 include；按出现顺序处理——后 include 的 binds 覆盖
//     先 include 的同键 binds（其余单节 merge、多节 append）；
//   - optional=true：文件缺失时仅警告（"optional include not
//     found"），非 optional 缺失是硬错误；
//   - 不支持 glob/directory include（路径按字面读取）。
//
// 职责：
//   - common.kdl：application 拥有的通用配置（机器无关）；
//   - host.kdl：host/profile 层经 generic extra-configuration-files
//     机制贡献的机器事实（本文件 optional——无 host 贡献的机器上
//     不存在，如 VM）；
//   - noctalia.kdl：Noctalia 运行时生成（唯一 owner = Noctalia，
//     Guix Home 不安装；本文件只 include 不声明）。
include "common.kdl"
include "host.kdl" optional=true
include "noctalia.kdl" optional=true
