# fcitx5 全局配置（repo-owned，derived state，不持久化）。
# 只声明相对默认值的刻意改动；未列出的选项随 fcitx5 默认。
# 行为基线：Arch 实机（niri）验证过的用户习惯（2026-08）。
#
# single-authority 立场同 profile：运行时经 configtool/IPC 改动会
# 被下次 Home activation 还原，配置修改只走仓库。

[Hotkey]
# 切换输入法：Super+Space（fcitx5 默认是 Ctrl+Space——本机习惯）。
[Hotkey/TriggerKeys]
0=Super+space

# 修饰键触发（默认仅 Shift_L；补 Shift_R 组合——本机习惯）。
[Hotkey/AltTriggerKeys]
0=Shift_L
1=Shift+Shift_R

[Behavior]
# 输入法激活状态不跨程序共享（默认 All）：每个窗口独立记住
# 键盘/Rime。Rime 自身的中英状态则全局共享，见 conf/rime.conf
# 的 InputState=All——两者是本机验证过的组合。
ShareInputState=No
